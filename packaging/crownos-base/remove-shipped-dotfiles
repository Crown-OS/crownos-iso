#!/bin/sh
# Releases up to 0.3.0 copied dotfiles into each new home that now have a
# system path. A home copy hides the system file, so system updates did not
# reach it. This removes each copy that is the same as a version that CrownOS
# shipped; a file that the user changed stays. crownos-desktop runs it before
# the desktop starts, one time for each version of the list.
set -eu

list=/usr/share/crownos/defaults-history/dotfiles.sha256
config=${XDG_CONFIG_HOME:-$HOME/.config}
marker=${XDG_STATE_HOME:-$HOME/.local/state}/crownos/shipped-dotfiles-removed

[ -r "$list" ] || exit 0
list_hash=$(sha256sum <"$list")
[ -r "$marker" ] && [ "$(cat -- "$marker")" = "$list_hash" ] && exit 0

while read -r shipped_hash relative_path; do
    file=$config/$relative_path
    if [ -f "$file" ] && [ ! -L "$file" ]; then
        file_hash=$(sha256sum <"$file")
        if [ "${file_hash%% *}" = "$shipped_hash" ]; then
            rm -f -- "$file"
            rmdir -- "${file%/*}" 2>/dev/null || true
        fi
    fi
done <"$list"

mkdir -p -- "${marker%/*}"
printf '%s\n' "$list_hash" >"$marker"
