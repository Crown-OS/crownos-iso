[Unit]
Description=Share this CrownOS desktop with other CrownOS machines on the tailnet
Documentation=https://github.com/crown-os/crownos-remote-desktop
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/crownos-remoted
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
