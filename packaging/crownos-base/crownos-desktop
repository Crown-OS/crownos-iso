#!/bin/sh
# Starts the CrownOS desktop in the current login session, on its VT. The
# compositor exits with RESTART_SESSION_STATUS (75) to restart the session.

export XDG_SESSION_TYPE=wayland
export XDG_ICON_THEME=CrownOS-dark
export CROWN_BACKEND=kms
export LIBSEAT_BACKEND=logind

status=75
while [ "$status" -eq 75 ]; do
    compositor "$@"
    status=$?
done
exit "$status"
