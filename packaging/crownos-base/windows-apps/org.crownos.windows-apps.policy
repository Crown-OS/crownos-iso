<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>CrownOS</vendor>
  <action id="org.crownos.windows-apps.manage">
    <description>Turn Windows apps support on or off</description>
    <message>Authentication is required to turn Windows apps support on or off</message>
    <icon_name>wine</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/crownos-windows-apps</annotate>
  </action>
</policyconfig>
