[Unit]
Description=Set up Windows apps support
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/usr/bin/wine
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/crownos-windows-apps install
Restart=on-failure
RestartSec=1min
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
