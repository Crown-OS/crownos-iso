#!/usr/bin/ash
# shellcheck shell=sh
# With crownos.recover=<N> on the kernel command line, makes a writable copy of
# snapper snapshot N the btrfs default subvolume, which the root mount that
# follows then mounts. The rEFInd entry "Rollback to CrownOS <version>" names
# the snapshot crownos-updated took before its last update. Any failure falls
# through to the current version.
#
# Each rollback leaves the root it replaces behind as an ordinary subvolume:
# @ after the first, @snapshots/<M>/snapshot after later ones. snapper never
# deletes them, because they carry no cleanup algorithm.

crownos_top=/crownos-top

crownos_bail() {
    err "crownos-recover: $1; starting the current version instead"
    if mountpoint -q "$crownos_top"; then
        umount "$crownos_top"
    fi
}

crownos_snapshot_number() {
    crownos_number=${1%/*}
    crownos_number=${crownos_number##*/}
    case $crownos_number in
    '' | *[!0-9]*) return 1 ;;
    esac
    printf '%s\n' "$crownos_number"
}

crownos_next_number() {
    crownos_highest=0
    for crownos_entry in "$crownos_top"/@snapshots/*/; do
        crownos_candidate=$(crownos_snapshot_number "${crownos_entry%/}/x") || continue
        if [ "$crownos_candidate" -gt "$crownos_highest" ]; then
            crownos_highest=$crownos_candidate
        fi
    done
    printf '%s\n' "$((crownos_highest + 1))"
}

crownos_already_recovered_from() {
    crownos_default=$(btrfs subvolume get-default "$crownos_top" | sed -n 's/.* path //p')
    case $crownos_default in
    @snapshots/*/snapshot) ;;
    *) return 1 ;;
    esac
    grep -q "<description>Recovered from snapshot $1</description>" \
        "$crownos_top/${crownos_default%/snapshot}/info.xml" 2>/dev/null
}

crownos_write_info() {
    cat >"$crownos_top/@snapshots/$1/info.xml" <<INFO
<?xml version="1.0"?>
<snapshot>
  <type>single</type>
  <num>$1</num>
  <date>$(date -u '+%Y-%m-%d %H:%M:%S')</date>
  <description>Recovered from snapshot $2</description>
</snapshot>
INFO
}

crownos_recover() {
    crownos_snapshot=$1
    case $crownos_snapshot in
    '' | *[!0-9]*)
        err "crownos-recover: crownos.recover=$crownos_snapshot names no snapshot number; starting the current version instead"
        return
        ;;
    esac
    modprobe btrfs 2>/dev/null
    # shellcheck disable=SC2154
    crownos_device=$(resolve_device "$root") ||
        { crownos_bail "the root device $root did not appear"; return; }
    mkdir -p "$crownos_top"
    mount -t btrfs -o subvolid=5 "$crownos_device" "$crownos_top" ||
        { crownos_bail "could not mount $crownos_device"; return; }

    [ -d "$crownos_top/@snapshots/$crownos_snapshot/snapshot" ] ||
        { crownos_bail "snapshot $crownos_snapshot does not exist"; return; }

    if crownos_already_recovered_from "$crownos_snapshot"; then
        msg ":: crownos-recover: already running a copy of snapshot $crownos_snapshot"
        umount "$crownos_top"
        touch /run/crownos-recovered
        return
    fi

    crownos_copy=$(crownos_next_number)
    mkdir -p "$crownos_top/@snapshots/$crownos_copy"
    if ! btrfs subvolume snapshot "$crownos_top/@snapshots/$crownos_snapshot/snapshot" \
        "$crownos_top/@snapshots/$crownos_copy/snapshot"; then
        rmdir "$crownos_top/@snapshots/$crownos_copy"
        crownos_bail "could not copy snapshot $crownos_snapshot"
        return
    fi
    if ! crownos_write_info "$crownos_copy" "$crownos_snapshot" ||
        ! btrfs subvolume set-default "$crownos_top/@snapshots/$crownos_copy/snapshot"; then
        btrfs subvolume delete "$crownos_top/@snapshots/$crownos_copy/snapshot"
        rm -rf "${crownos_top:?}/@snapshots/$crownos_copy"
        crownos_bail "could not make snapshot $crownos_copy the system"
        return
    fi
    touch /run/crownos-recovered
    umount "$crownos_top"
    msg ":: crownos-recover: starting snapshot $crownos_snapshot"
}

run_hook() {
    read -r crownos_cmdline </proc/cmdline
    for crownos_argument in $crownos_cmdline; do
        case $crownos_argument in
        crownos.recover=*)
            crownos_recover "${crownos_argument#crownos.recover=}"
            return
            ;;
        crownos.recover)
            err "crownos-recover: crownos.recover names no snapshot; starting the current version instead"
            return
            ;;
        esac
    done
}
