#!/usr/bin/env bash

build() {
    add_module btrfs
    add_binary btrfs
    add_binary date
    add_runscript
}

help() {
    cat <<HELPEOF
Rolls the root back to snapper snapshot N when the kernel command line carries
crownos.recover=N, which the rEFInd entry "Rollback to CrownOS <version>" does.
Place it after 'block' and before 'filesystems'.
HELPEOF
}
