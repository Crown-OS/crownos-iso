# shellcheck shell=bash disable=SC2034,SC2154
# What coding agents need to know about the CrownOS desktop: the skills under
# /usr/share/crownos/skills, linked into the system-wide skill folders of
# Claude Code and Codex; a Claude Code plugin with those skills, crownotify
# hooks and the crownos-computer-use MCP server, served from a local
# marketplace that managed settings force-enable; the settings reference
# generated by crownos-config; and a per-user setup command for agents that
# only read the home directory. scripts/manifest.sh passes the ISO version in
# CROWNOS_VERSION and the sibling checkouts' parent in CROWNOS_SIBLINGS.

pkgname=crownos-agent-skills
pkgver=${CROWNOS_VERSION:?}
pkgrel=1
pkgdesc='Skills, hooks and MCP wiring that teach coding agents the CrownOS desktop'
arch=(any)
url='https://github.com/Crown-OS/crownos-iso'
license=(MIT)
depends=(jq libnotify)
options=(!debug)
backup=(etc/claude-code/managed-settings.json)

_siblings=${CROWNOS_SIBLINGS:-$startdir/../../..}
_skills=/usr/share/crownos/skills
_marketplace=/usr/share/crownos/claude-marketplace

package() {
    local plugins_skill=$_siblings/crownos-plugins/skill/SKILL.md
    local config_docs=$_siblings/crownos-config/docs/config
    [[ -f $plugins_skill ]] || { printf 'error: no crownos-plugins checkout at %s\n' "$_siblings" >&2; return 1; }
    [[ -f $config_docs/index.md ]] || { printf 'error: %s is missing; run cargo xtask config-docs in crownos-config\n' "$config_docs" >&2; return 1; }

    install -d "$pkgdir$_skills"
    cp -r --no-preserve=ownership -- "$startdir"/skills/. "$pkgdir$_skills/"
    install -Dm644 "$plugins_skill" "$pkgdir$_skills/crownos-plugins/SKILL.md"
    install -Dm644 -t "$pkgdir/usr/share/doc/crownos/config" "$config_docs"/*.md
    install -Dm644 "$startdir/README.md" "$pkgdir/usr/share/doc/crownos/agent-skills.md"

    local plugin=$pkgdir$_marketplace/plugins/crownos
    install -Dm644 "$startdir/marketplace/.claude-plugin/marketplace.json" "$pkgdir$_marketplace/.claude-plugin/marketplace.json"
    install -Dm644 "$startdir/plugin/.claude-plugin/plugin.json" "$plugin/.claude-plugin/plugin.json"
    install -Dm644 "$startdir/plugin/.mcp.json" "$plugin/.mcp.json"
    install -Dm644 "$startdir/plugin/README.md" "$plugin/README.md"
    install -Dm644 "$startdir/plugin/hooks/hooks.json" "$plugin/hooks/hooks.json"
    install -Dm755 -t "$plugin/hooks" "$startdir"/plugin/hooks/*.sh

    install -d "$plugin/skills" "$pkgdir/etc/claude-code/.claude/skills" "$pkgdir/etc/codex/skills"
    local skill name
    for skill in "$pkgdir$_skills"/*/; do
        name=$(basename "$skill")
        ln -s "$_skills/$name" "$plugin/skills/$name"
        ln -s "$_skills/$name" "$pkgdir/etc/claude-code/.claude/skills/$name"
        ln -s "$_skills/$name" "$pkgdir/etc/codex/skills/$name"
    done

    install -Dm644 "$startdir/managed-settings.json" "$pkgdir/etc/claude-code/managed-settings.json"
    install -Dm644 "$startdir/50-crownos.json" "$pkgdir/etc/claude-code/managed-settings.d/50-crownos.json"
    install -Dm755 "$startdir/crownos-agent-skills" "$pkgdir/usr/bin/crownos-agent-skills"
}
