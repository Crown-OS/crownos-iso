#!/bin/sh
# Links the CrownOS skills under /usr/share/crownos/skills into the per-user skill folders of the
# coding agents present on this account. Claude Code and Codex read them system-wide already; this
# covers the agents that only look in the home directory.
#
#   crownos-agent-skills            link for every agent found
#   crownos-agent-skills --remove   remove the links again
#   crownos-agent-skills --list     print the folders that would be linked into
set -eu

skills=/usr/share/crownos/skills
home=${HOME:?HOME is not set}

folders() {
    if [ -d "$home/.agents" ] || [ -d "$home/.codex" ] || command -v codex >/dev/null 2>&1; then
        printf '%s\n' "$home/.agents/skills"
    fi
    if [ -d "$home/.gemini" ] || command -v antigravity >/dev/null 2>&1 || command -v agy >/dev/null 2>&1; then
        printf '%s\n' "$home/.gemini/config/skills"
    fi
}

link_into() {
    dir=$1
    mkdir -p "$dir"
    for skill in "$skills"/*/; do
        skill=${skill%/}
        target=$dir/$(basename "$skill")
        if [ -e "$target" ] && [ ! -L "$target" ]; then
            continue
        fi
        ln -sfn "$skill" "$target"
    done
}

remove_from() {
    dir=$1
    [ -d "$dir" ] || return 0
    for skill in "$skills"/*/; do
        target=$dir/$(basename "${skill%/}")
        if [ -L "$target" ] && [ "$(readlink "$target")" = "${skill%/}" ]; then
            rm -f "$target"
        fi
    done
}

[ -d "$skills" ] || exit 0
case ${1:-} in
    '') folders | while IFS= read -r dir; do link_into "$dir"; done ;;
    --remove) folders | while IFS= read -r dir; do remove_from "$dir"; done ;;
    --list) folders ;;
    *) printf 'usage: crownos-agent-skills [--remove|--list]\n' >&2; exit 64 ;;
esac
