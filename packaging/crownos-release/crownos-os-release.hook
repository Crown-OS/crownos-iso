[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/os-release

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = crownos-release

[Action]
Description = Writing the CrownOS os-release...
When = PostTransaction
Exec = /usr/bin/cp -f /usr/lib/crownos/os-release /usr/lib/os-release
