[Unit]
Description=CrownOS Installer
Wants=seatd.service NetworkManager.service
After=seatd.service NetworkManager.service systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
ExecStart=/usr/bin/cage -- /usr/bin/crownos-installer
Environment=LIBSEAT_BACKEND=seatd
Environment=XDG_RUNTIME_DIR=%t/crownos
RuntimeDirectory=crownos
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
