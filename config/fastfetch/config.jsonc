{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/crownos.txt",
        "color": { "1": "yellow", "2": "magenta" },
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "yellow", "title": "yellow" }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "terminal",
        "display",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "battery",
        "break",
        "colors"
    ]
}
